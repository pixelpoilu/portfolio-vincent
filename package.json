{
  "name": "portfolio-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:portfolio": "react-router dev",
    "dev:home": "vite --config vite.home.config.ts",
    "devhost": "react-router dev --host",
    "build": "npm run build:portfolio && npm run build:home && node scripts/finalize-production.js",
    "build:portfolio": "tsc -b && react-router build && node scripts/convert-to-webp.js dist/portfolio-build/client",
    "build:home": "vite build --config vite.home.config.ts",
    "lint1": "eslint .",
    "lint2": "eslint src --ext js,jsx,ts,tsx",
    "lint": "eslint -- --fix",
    "preview": "vite preview --config vite.home.config.ts --outDir ../dist/client",
    "savegit": "git add . && git commit -m \"Sauvegarde du jour\" && git push",
    "typecheck": "tsc --noEmit",
    "check": "npm run eslint && npm run typecheck && npm run build && npx knip"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@react-icons/all-files": "^4.1.0",
    "@react-router/node": "^7.16.0",
    "@tailwindcss/vite": "^4.2.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "framer-motion": "^12.34.1",
    "image-dimensions": "^2.5.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.5.0",
    "react-router": "^7.16.0",
    "react-router-dom": "^7.13.0",
    "react-router-hash-link": "^2.4.3",
    "tailwindcss": "^4.2.2",
    "isbot": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@react-router/dev": "^7.16.0",
    "@react-router/serve": "^7.16.0",
    "@types/node": "^24.10.1",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "svgo": "^4.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.36.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-image-optimizer": "^2.0.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
